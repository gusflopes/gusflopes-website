---
// Artigos (16/11/2026): a seção autoral manteve a rota /insights/ (e /insights/article/<id>) para não quebrar links;
// só o rótulo mudou para "Artigos".
import Default from '../layouts/Default.astro';
import { InsightsPage } from '../components/pages/InsightsPage';
import { getArtigos } from '../lib/artigos';

const articles = await getArtigos();
---

<Default
  title="Artigos"
  description="Textos autorais de Gustavo Lopes sobre engenharia, negócio e IA aplicada, com filtro por público: liderança, quem executa, empresa com TI enxuta e empresa sem TI."
>
  <InsightsPage articles={articles} client:load />
</Default>
