---
import Default from '../layouts/Default.astro';
import { InsightsPage } from '../components/pages/InsightsPage';
import { getArtigos } from '../lib/artigos';

const articles = await getArtigos();
---

<Default
  title="Insights"
  description="Textos autorais de Gustavo Lopes sobre engenharia, negócio e IA aplicada — em três eixos: Engenharia & IA, Negócios e Bastidores."
>
  <InsightsPage articles={articles} client:load />
</Default>
