---
import { render } from 'astro:content';
import Default from '../../layouts/Default.astro';
import { TechRadarPage } from '../../components/pages/TechRadarPage';
import { getEdicoesRadar, type EdicaoRadarEntry } from '../../lib/noticias';
import { edicaoView, outrasEdicoes } from '../../lib/tech-radar';

export async function getStaticPaths() {
  const edicoes = await getEdicoesRadar();
  return edicoes.map((entry) => ({ params: { edicao: entry.id }, props: { entry, edicoes } }));
}

interface Props {
  entry: EdicaoRadarEntry;
  edicoes: EdicaoRadarEntry[];
}

const { entry, edicoes } = Astro.props;
const { Content } = await render(entry);
const edicao = await edicaoView(entry);
---

<Default title={`Tech radar · ${entry.data.title}`} description={entry.data.excerpt} type="article" publishedDate={entry.data.date}>
  <TechRadarPage edicao={edicao} outras={outrasEdicoes(edicoes, entry.id)} client:load>
    <Content />
  </TechRadarPage>
</Default>
