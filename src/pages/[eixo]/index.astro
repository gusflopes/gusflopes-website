---
import Default from '../../layouts/Default.astro';
import { InsightsPage } from '../../components/pages/InsightsPage';
import { getArtigos } from '../../lib/artigos';
import { EIXOS, EIXO_IDS, type EixoId } from '../../lib/eixos';
import { comUtm, projetos } from '../../config/site';

export function getStaticPaths() {
  return EIXO_IDS.map((eixo) => ({ params: { eixo } }));
}

const eixo = Astro.params.eixo as EixoId;
const def = EIXOS[eixo];
// Hub do eixo = textos autorais dos dois formatos (Insights + Radar local).
const articles = await getArtigos({ eixo, incluirRadarLocal: true });
const reforma = projetos.reforma;
---

<Default
  title={def.label}
  description={`${def.descricao} ${def.publico}`}
  noindex={articles.length === 0}
>
  <InsightsPage
    articles={articles}
    heading={def.label}
    subheading={def.descricao}
    eixo={eixo}
    client:load
  >
    {
      eixo === 'bastidores' && (
        <aside
          slot="aside"
          class="grid lg:grid-cols-12 gap-[2px] bg-azul-3 border-2 border-azul-3"
        >
          <h2 class="campo-azul lg:col-span-8 p-6 md:p-8 display uppercase text-[2rem] md:text-[3rem] text-papel">{reforma.nome}</h2>
          <p class="campo-azul lg:col-span-4 px-6 pb-6 md:p-8 rotulo text-laranja">Experimento aberto</p>
          <p class="campo-azul lg:col-span-8 p-6 md:p-8 font-serif text-[1.125rem] leading-relaxed text-ceu-claro">
            Uma dúvida real de empresário: como a reforma tributária afeta a minha empresa? Virou um experimento
            aberto. A mesma IA que você já usa, ligada a um servidor MCP com a calculadora oficial da
            Receita, passa a responder com números e fontes em vez de palpites. É a demonstração de
            que ferramenta e contexto certos mudam o que a IA consegue fazer, mesmo para quem nunca
            mexeu com isso.
          </p>
          <a
            href={comUtm(reforma.url, reforma.campanha, 'bastidores-hub')}
            class="celula-acao campo-laranja lg:col-span-4 p-6 md:p-8 min-h-[8rem] group"
          >
            <span class="font-sans font-[850] [font-stretch:62%] uppercase text-[1.75rem] md:text-[2.25rem] leading-[0.92]">Testar o simulador</span>
            <svg class="self-end transition-transform duration-200 group-hover:translate-x-1" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
        </aside>
      )
    }
  </InsightsPage>
</Default>
