---
import Default from '../../layouts/Default.astro';
import { InsightsPage } from '../../components/pages/InsightsPage';
import { getArtigos } from '../../lib/artigos';
import { EIXOS, EIXO_IDS, type EixoId } from '../../lib/eixos';
import { comUtm, projetos } from '../../config/site';
import { fundoQuadro } from '../../lib/imagens';

export function getStaticPaths() {
  return EIXO_IDS.map((eixo) => ({ params: { eixo } }));
}

const eixo = Astro.params.eixo as EixoId;
const def = EIXOS[eixo];
// Hub do eixo = textos autorais dos dois formatos (Insights + Radar local).
const articles = await getArtigos({ eixo, incluirRadarLocal: true });
const reforma = projetos.reforma;
const fundo = await fundoQuadro();
---

<Default
  title={def.label}
  description={`${def.descricao} ${def.publico}`}
  noindex={articles.length === 0}
>
  <InsightsPage
    articles={articles}
    heading={def.label}
    subheading={def.descricao}
    eixo={eixo}
    fundo={fundo}
    client:load
  >
    {
      eixo === 'bastidores' && (
        <aside
          slot="aside"
          class="bg-noite text-white rounded-[4px] p-7 md:p-10 grid gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12"
        >
          <div>
            <h2 class="font-serif font-semibold text-[1.75rem] md:text-[2.125rem] leading-[1.12] text-white">{reforma.nome}</h2>
            <p class="mt-3 font-sans text-[0.9375rem] font-semibold text-laranja-claro">
              Experimento aberto
            </p>
          </div>
          <div>
            <p class="font-sans text-[1.0625rem] text-nevoa leading-relaxed mb-6">
              Uma dúvida real de empresário: como a reforma tributária afeta a minha empresa? Virou um experimento
              aberto. A mesma IA que você já usa, ligada a um servidor MCP com a calculadora oficial da
              Receita, passa a responder com números e fontes em vez de palpites. É a demonstração de
              que ferramenta e contexto certos mudam o que a IA consegue fazer, mesmo para quem nunca
              mexeu com isso.
            </p>
            <a href={comUtm(reforma.url, reforma.campanha, 'bastidores-hub')} class="botao">
              Testar o simulador →
            </a>
          </div>
        </aside>
      )
    }
  </InsightsPage>
</Default>
