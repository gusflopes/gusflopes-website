---
// Página 404 real: o Worker (wrangler.jsonc → not_found_handling: "404-page")
// serve este arquivo com status 404 para qualquer URL inexistente.
import Default from '../layouts/Default.astro';

const caminhos = [
  { href: '/insights', label: 'Insights', desc: 'Textos autorais sobre engenharia, negócio e IA.' },
  { href: '/radar', label: 'Radar', desc: 'Curadoria comentada do que importa agora.' },
  { href: '/#consulting', label: 'Trabalhe comigo', desc: 'Consultoria, mentoria e parcerias.' },
];
---

<Default
  title="Página não encontrada"
  description="O endereço acessado não existe ou mudou de lugar."
  noindex
>
  <main class="pt-36 md:pt-44 pb-24 md:pb-32 px-4 sm:px-6 min-h-screen bg-noite">
    <div class="max-w-5xl mx-auto w-full">
      <h1 class="display-opsz font-serif font-semibold text-[2.625rem] md:text-[4.25rem] text-white leading-[1] max-w-[14ch]">
        Esta página não existe <br />
        <span class="text-laranja">ou mudou de lugar</span>
      </h1>
      <p class="meta mt-5 mb-10"><span>Erro 404</span></p>
      <p class="font-sans text-lg text-nevoa leading-relaxed max-w-xl mb-14">
        O link pode estar quebrado ou o texto foi renomeado. Comece por um destes caminhos:
      </p>

      <ul class="border-t border-noite-fio-forte mb-14 max-w-3xl">
        {
          caminhos.map((c) => (
            <li class="border-b border-noite-fio">
              <a href={c.href} class="group grid gap-1 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-8 sm:items-baseline py-6">
                <span class="block font-serif text-[1.625rem] leading-tight text-white group-hover:text-laranja-palido transition-colors">{c.label}</span>
                <span class="block font-sans text-[0.9375rem] text-nevoa leading-relaxed">{c.desc}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/" class="botao">Voltar para o início</a>
    </div>
  </main>
</Default>
