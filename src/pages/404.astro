---
// Página 404 real: o Worker (wrangler.jsonc → not_found_handling: "404-page")
// serve este arquivo com status 404 para qualquer URL inexistente.
import Default from '../layouts/Default.astro';

const caminhos = [
  { href: '/insights', label: 'Insights', desc: 'Textos autorais sobre engenharia, negócio e IA.' },
  { href: '/radar', label: 'Radar', desc: 'Curadoria comentada do que importa agora.' },
  { href: '/#consulting', label: 'Trabalhe comigo', desc: 'Consultoria, mentoria e parcerias.' },
];
---

<Default
  title="Página não encontrada"
  description="O endereço acessado não existe ou mudou de lugar."
  noindex
>
  <main class="campo-azul pt-[72px] min-h-screen">
    <div class="moldura pt-14 md:pt-20 pb-24">
      <p class="rotulo text-laranja mb-8">Erro 404</p>
      <h1 class="display uppercase text-papel text-[2.75rem] md:text-[5.5rem] leading-[0.92] mb-8 max-w-[14ch]">
        Esta página não existe <br />
        <span class="text-transparent [-webkit-text-stroke:2px_var(--papel)]">ou mudou de lugar</span>
      </h1>
      <p class="font-serif text-[1.1875rem] text-ceu-claro leading-relaxed max-w-xl mb-12">
        O link pode estar quebrado ou o texto foi renomeado. Comece por um destes caminhos:
      </p>

      <ul class="grid md:grid-cols-3 gap-[2px] bg-azul border-y-2 border-papel mb-12">
        {
          caminhos.map((c) => (
            <li class="bg-azul">
              <a href={c.href} class="group block h-full py-6 md:pr-6 border-b md:border-b-0 border-azul-3">
                <span class="block display uppercase text-[1.5rem] text-papel group-hover:text-laranja transition-colors mb-2">{c.label}</span>
                <span class="block font-serif text-[1rem] text-ceu-claro leading-relaxed">{c.desc}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/" class="botao">Voltar para o início</a>
    </div>
  </main>
</Default>
