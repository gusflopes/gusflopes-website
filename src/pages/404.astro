---
// Página 404 real: o Worker (wrangler.jsonc → not_found_handling: "404-page")
// serve este arquivo com status 404 para qualquer URL inexistente.
import Default from '../layouts/Default.astro';

const caminhos = [
  { href: '/insights', label: 'Insights', desc: 'Textos autorais sobre engenharia, negócio e IA.' },
  { href: '/radar', label: 'Radar', desc: 'Curadoria comentada do que importa agora.' },
  { href: '/#consulting', label: 'Trabalhe comigo', desc: 'Consultoria, mentoria e parcerias.' },
];
---

<Default
  title="Página não encontrada"
  description="O endereço acessado não existe ou mudou de lugar."
  noindex
>
  <main class="pt-12 md:pt-20 pb-24 px-4 sm:px-6 min-h-[70vh] bg-noite">
    <div class="max-w-4xl mx-auto w-full">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-[1.04] tracking-[-0.03em] mb-6">
        Esta página não existe <br />
        <span class="text-laranja-claro">ou mudou de lugar</span>
      </h1>
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-ambar mb-6">Erro 404</p>
      <p class="font-serif text-lg md:text-xl text-nevoa leading-relaxed max-w-xl mb-12">
        O link pode estar quebrado ou o texto foi renomeado. Comece por um destes caminhos:
      </p>

      <div class="relative mb-14">
        <span aria-hidden="true" class="absolute hidden md:block left-0 right-0 top-[calc(0.5rem-3px)] h-1.5 rounded-full bg-laranja"></span>
        <span aria-hidden="true" class="absolute md:hidden left-[calc(0.5rem-3px)] top-2 bottom-2 w-1.5 rounded-full bg-laranja"></span>
        <ul class="relative grid gap-8 md:grid-cols-3 list-none m-0 p-0">
          {
            caminhos.map((c) => (
              <li class="relative pl-9 md:pl-0 md:pt-10">
                <a href={c.href} class="group block">
                  <span aria-hidden="true" class="estacao-ponto absolute left-0 top-0" />
                  <span class="block text-xl font-extrabold text-white mb-1 group-hover:underline decoration-laranja decoration-2 underline-offset-4">{c.label}</span>
                  <span class="block font-serif text-[1.02rem] text-nevoa leading-relaxed">{c.desc}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href="/"
        class="inline-flex items-center justify-center bg-laranja hover:bg-laranja-claro text-brasa font-bold px-7 min-h-12 rounded-md transition-colors"
      >
        Voltar para o início
      </a>
    </div>
  </main>
</Default>
