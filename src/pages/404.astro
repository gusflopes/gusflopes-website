---
// Página 404 real: o Worker (wrangler.jsonc → not_found_handling: "404-page")
// serve este arquivo com status 404 para qualquer URL inexistente.
import Default from '../layouts/Default.astro';
import { TelaPicture } from '../components/TelaPicture';
import { telaPainel404 } from '../lib/telas';

const caminhos = [
  { href: '/insights', label: 'Insights', desc: 'Textos autorais sobre engenharia, negócio e IA.' },
  { href: '/radar', label: 'Radar', desc: 'Curadoria comentada do que importa agora.' },
  { href: '/#consulting', label: 'Trabalhe comigo', desc: 'Consultoria, mentoria e parcerias.' },
];
---

<Default
  title="Página não encontrada"
  description="O endereço acessado não existe ou mudou de lugar."
  noindex
>
  <main class="bg-papel papel min-h-[80vh] lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,40%)]">
    <!-- Abertura própria do 404: massas que se encontram num painel ao lado da mensagem, fio vertical.
         A mensagem fica em papel: o rodapé chega pela fita depois de um campo claro. -->
    <div class="h-[132px] md:h-[200px] lg:h-auto overflow-hidden lg:order-last border-b-[3px] lg:border-b-0 lg:border-l-[3px] border-laranja" aria-hidden="true">
      <TelaPicture tela={telaPainel404()} sizes="(min-width: 1024px) 40vw, 100vw" />
    </div>
    <div class="px-4 md:px-6 lg:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] lg:pr-14 pt-10 pb-20 md:pt-14 md:pb-28 lg:py-24">
      <h1 class="font-serif text-[2.4rem] md:text-6xl leading-[1.04] tracking-[-0.015em] text-tinta mb-4 max-w-3xl">
        Esta página não existe <br />
        <span class="text-petroleo">ou mudou de lugar</span>
      </h1>
      <p class="rotulo text-petroleo mb-8 flex items-center gap-2.5"><span class="marca" aria-hidden="true"></span>Erro 404</p>
      <p class="font-sans text-lg text-tinta-2 leading-relaxed max-w-xl mb-10">
        O link pode estar quebrado ou o texto foi renomeado. Comece por um destes caminhos:
      </p>

      <ul class="mb-12 border-t-4 border-laranja max-w-2xl">
        {
          caminhos.map((c) => (
            <li class="border-b border-regua">
              <a href={c.href} class="cartao group grid gap-1 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6 py-5">
                <span class="block font-serif text-xl text-tinta group-hover:text-laranja-fundo transition-colors">{c.label}</span>
                <span class="block font-sans text-sm text-tinta-2 leading-relaxed sm:pt-1">{c.desc}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/" class="botao">Voltar para o início</a>
    </div>
  </main>
</Default>
