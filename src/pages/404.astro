---
// Página 404 real: o Worker (wrangler.jsonc → not_found_handling: "404-page")
// serve este arquivo com status 404 para qualquer URL inexistente.
import Default from '../layouts/Default.astro';
import { TelaPicture } from '../components/TelaPicture';
import { telaFaixa } from '../lib/telas';

const caminhos = [
  { href: '/insights', label: 'Insights', desc: 'Textos autorais sobre engenharia, negócio e IA.' },
  { href: '/radar', label: 'Radar', desc: 'Curadoria comentada do que importa agora.' },
  { href: '/#consulting', label: 'Trabalhe comigo', desc: 'Consultoria, mentoria e parcerias.' },
];
---

<Default
  title="Página não encontrada"
  description="O endereço acessado não existe ou mudou de lugar."
  noindex
>
  <main class="bg-noite min-h-[80vh]">
    <div class="h-[132px] md:h-auto md:aspect-[6/1] overflow-hidden" aria-hidden="true">
      <TelaPicture tela={telaFaixa('radar')} sizes="100vw" />
    </div>
    <div class="fio">
      <div class="max-w-7xl mx-auto px-4 md:px-6 pt-10 pb-20 md:pt-14 md:pb-28">
        <h1 class="font-serif text-[2.4rem] md:text-6xl leading-[1.04] tracking-[-0.015em] text-white mb-4 max-w-3xl">
          Esta página não existe <br />
          <span class="text-pessego">ou mudou de lugar</span>
        </h1>
        <p class="rotulo text-laranja-claro mb-8">Erro 404</p>
        <p class="font-sans text-lg text-nevoa leading-relaxed max-w-xl mb-10">
          O link pode estar quebrado ou o texto foi renomeado. Comece por um destes caminhos:
        </p>

        <ul class="grid gap-x-8 md:grid-cols-3 mb-12 border-t border-linha md:border-t-0">
          {
            caminhos.map((c) => (
              <li class="border-b md:border-b-0 md:border-t border-linha">
                <a href={c.href} class="cartao group block py-5">
                  <span class="block font-serif text-xl text-white group-hover:text-pessego transition-colors mb-1">{c.label}</span>
                  <span class="block font-sans text-sm text-nevoa leading-relaxed">{c.desc}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <a href="/" class="botao">Voltar para o início</a>
      </div>
    </div>
  </main>
</Default>
