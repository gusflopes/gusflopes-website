---
import { getCollection, render } from 'astro:content';
import { publicado } from '../../../lib/publicado';
import type { CollectionEntry } from 'astro:content';
import Default from '../../../layouts/Default.astro';
import { InsightArticlePage } from '../../../components/pages/InsightArticlePage';
import { formatDatePtBR } from '../../../lib/format';
import { telaCapa, ogDoTexto } from '../../../lib/telas';

export async function getStaticPaths() {
  const entries = await getCollection('insights', publicado);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// A foto de banco do frontmatter (image) não entra no render: capa e OG são a tela gerada do slug.
const { title, excerpt, category, eixo, date, duration } = entry.data;
---

<Default
  title={title}
  description={excerpt}
  image={ogDoTexto('insights', entry.id)}
  type="article"
  publishedDate={date}
>
  <InsightArticlePage
    title={title}
    excerpt={excerpt}
    category={category}
    eixo={eixo}
    dateFormatted={formatDatePtBR(date)}
    duration={duration}
    tela={telaCapa('insights', entry.id)}
    slug={entry.id}
    client:load
  >
    <Content />
  </InsightArticlePage>
</Default>
