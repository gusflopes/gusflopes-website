---
import { getCollection, render } from 'astro:content';
import { publicado } from '../../../lib/publicado';
import type { CollectionEntry } from 'astro:content';
import Default from '../../../layouts/Default.astro';
import { InsightArticlePage } from '../../../components/pages/InsightArticlePage';
import { formatDatePtBR } from '../../../lib/format';
import { fundoQuadro } from '../../../lib/imagens';

export async function getStaticPaths() {
  const entries = await getCollection('insights', publicado);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, excerpt, category, eixo, date, duration, image } = entry.data;
---

<Default
  title={title}
  description={excerpt}
  image={image}
  type="article"
  publishedDate={date}
>
  <InsightArticlePage
    title={title}
    excerpt={excerpt}
    category={category}
    eixo={eixo}
    dateFormatted={formatDatePtBR(date)}
    duration={duration}
    image={image}
    fundo={await fundoQuadro()}
    client:load
  >
    <Content />
  </InsightArticlePage>
</Default>
