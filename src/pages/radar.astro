---
import { getCollection } from 'astro:content';
import Default from '../layouts/Default.astro';
import { RadarPage, type RadarItem } from '../components/pages/RadarPage';
import { compareIsoDateDesc, formatDatePtBR } from '../lib/format';

const entries = await getCollection('radar');
const items: RadarItem[] = entries
  .sort((a, b) => compareIsoDateDesc(a.data.date, b.data.date))
  .map((entry) => ({
    id: entry.id,
    ...entry.data,
    date: formatDatePtBR(entry.data.date),
    link: entry.data.isExternal ? entry.data.link : `/radar/article/${entry.id}`,
  }));
---

<Default
  title="Radar"
  description="Curadoria comentada por Gustavo Lopes: o que mudou em IA, engenharia de software e negócios — e por que importa."
>
  <RadarPage items={items} client:load />
</Default>
