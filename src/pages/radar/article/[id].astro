---
import { getCollection, render } from 'astro:content';
import { publicado } from '../../../lib/publicado';
import type { CollectionEntry } from 'astro:content';
import Default from '../../../layouts/Default.astro';
import { RadarArticlePage } from '../../../components/pages/RadarArticlePage';
import { formatDatePtBR } from '../../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('radar', publicado);
  return entries
    .filter((entry) => !entry.data.isExternal)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'radar'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// H2 do corpo: o sumário da margem usa os títulos reais das seções.
const secoes = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const { title, excerpt, category, eixo, date, duration, image } = entry.data;
---

<Default
  title={title}
  description={excerpt}
  image={image}
  type="article"
  publishedDate={date}
>
  <RadarArticlePage
    title={title}
    excerpt={excerpt}
    category={category}
    eixo={eixo}
    dateFormatted={formatDatePtBR(date)}
    duration={duration}
    secoes={secoes}
    image={image}
    client:load
  >
    <Content />
  </RadarArticlePage>
</Default>
