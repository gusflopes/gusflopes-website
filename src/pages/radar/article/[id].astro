---
import { getCollection, render } from 'astro:content';
import { publicado } from '../../../lib/publicado';
import type { CollectionEntry } from 'astro:content';
import Default from '../../../layouts/Default.astro';
import { RadarArticlePage } from '../../../components/pages/RadarArticlePage';
import { formatDatePtBR } from '../../../lib/format';
import { proximoTexto } from '../../../lib/artigos';
import { telaRetrato, ogDoTexto, fundoMargem, fundoCapitulos } from '../../../lib/telas';

export async function getStaticPaths() {
  const entries = await getCollection('radar', publicado);
  return entries
    .filter((entry) => !entry.data.isExternal)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'radar'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// A foto de banco do frontmatter (image) não entra no render: capa e OG são a tela gerada do slug.
const { title, excerpt, category, eixo, date, duration } = entry.data;
const proximo = await proximoTexto('radar', entry.id, eixo);
---

<Default
  title={title}
  description={excerpt}
  image={ogDoTexto('radar', entry.id)}
  type="article"
  publishedDate={date}
>
  <RadarArticlePage
    title={title}
    excerpt={excerpt}
    category={category}
    eixo={eixo}
    dateFormatted={formatDatePtBR(date)}
    duration={duration}
    tela={telaRetrato('radar', entry.id)}
    margem={fundoMargem('radar', entry.id)}
    capitulos={fundoCapitulos('radar', entry.id)}
    proximo={proximo}
    slug={entry.id}
    client:load
  >
    <Content />
  </RadarArticlePage>
</Default>
