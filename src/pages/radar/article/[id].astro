---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Default from '../../../layouts/Default.astro';
import { RadarArticlePage } from '../../../components/pages/RadarArticlePage';
import { formatDatePtBR } from '../../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('radar');
  return entries
    .filter((entry) => !entry.data.isExternal)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'radar'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, excerpt, category, eixo, date, duration, image } = entry.data;
---

<Default
  title={title}
  description={excerpt}
  image={image}
  type="article"
  publishedDate={date}
>
  <RadarArticlePage
    title={title}
    excerpt={excerpt}
    category={category}
    eixo={eixo}
    dateFormatted={formatDatePtBR(date)}
    duration={duration}
    image={image}
    client:load
  >
    <Content />
  </RadarArticlePage>
</Default>
