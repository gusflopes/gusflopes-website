---
import { getCollection } from 'astro:content';
import { publicado } from '../lib/publicado';
import { Header } from '../components/Header';
import { EIXO_IDS } from '../lib/eixos';
import { Footer } from '../components/Footer';
// Fontes self-hosted (sem Google Fonts), concretismo: Archivo variável com eixos de peso e
// largura (display 900/100 = "Archivo Black", rótulos 600/75 = "Archivo Narrow"), Source Serif 4
// para leitura (itálico só baixa se usado) e JetBrains Mono só para código.
// Subsets carregam sob demanda via unicode-range.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import sansLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '../index.css';
import fotoAutor from '../assets/autor.jpg?url';
import { site, author, socials, newsletter } from '../config/site';

// OG padrão: 1200×630, JPG (~95 KB) — a arte do hero recortada no formato das prévias sociais.
const OG_DEFAULT = '/og-default.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  /** Página sem conteúdo próprio ainda (ex.: hub de eixo vazio) — fora do índice. */
  noindex?: boolean;
}

const {
  title,
  description = 'Tecnologia e negócio, partes do mesmo sistema: arquitetura, plataformas e IA aplicada por Gustavo Lopes.',
  image = OG_DEFAULT,
  type = 'website',
  publishedDate,
  noindex = false,
} = Astro.props;

// Eixos com conteúdo autoral publicado: só esses aparecem no menu.
const autorais = [
  ...(await getCollection('insights', publicado)),
  ...(await getCollection('radar', (e) => publicado(e) && !e.data.isExternal)),
];
const eixosAtivos = EIXO_IDS.filter((id) => autorais.some((e) => e.data.eixo === id));

const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const pageTitle = isHome
  ? 'gusflopes.dev — Tecnologia e negócio, partes do mesmo sistema'
  : `${title ?? 'gusflopes.dev'} — gusflopes.dev`;

const canonicalUrl = new URL(pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Dados estruturados (schema.org): a pessoa em todas as páginas, o site na home e o artigo nas páginas de texto.
const pessoa = {
  '@type': 'Person',
  '@id': `${site.url}/#autor`,
  name: author.name,
  jobTitle: author.role,
  description: author.bio,
  url: site.url,
  image: new URL(fotoAutor, Astro.site).toString(),
  sameAs: [...Object.values(socials), newsletter.substack].filter(Boolean),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    pessoa,
    ...(isHome
      ? [{ '@type': 'WebSite', '@id': `${site.url}/#site`, url: site.url, name: site.shortName, inLanguage: 'pt-BR', publisher: { '@id': pessoa['@id'] } }]
      : []),
    ...(type === 'article'
      ? [{
          '@type': 'BlogPosting',
          headline: title,
          description,
          image: ogImage.toString(),
          datePublished: publishedDate,
          inLanguage: 'pt-BR',
          mainEntityOfPage: canonicalUrl.toString(),
          author: { '@id': pessoa['@id'] },
          publisher: { '@id': pessoa['@id'] },
        }]
      : []),
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gustavo Lopes" />
    <meta name="theme-color" content="#0b1a33" />
    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="gusflopes.dev — Tecnologia e negócio"
      href="/rss.xml"
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content="gusflopes.dev" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {
      image === OG_DEFAULT && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:type" content="image/jpeg" />
        </>
      )
    }
    <meta property="og:locale" content="pt_BR" />
    {
      type === 'article' && publishedDate && (
        <meta property="article:published_time" content={publishedDate} />
      )
    }
    {type === 'article' && <meta property="article:author" content="Gustavo Lopes" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="campo-azul min-h-screen overflow-x-hidden font-sans">
    <Header pathname={pathname} eixosAtivos={eixosAtivos} client:load />
    <slot />
    {/* Páginas que já terminam com o plano laranja da newsletter (textos e /newsletter) não repetem a célula no rodapé. */}
    <Footer comNewsletter={type !== 'article' && !pathname.startsWith('/newsletter')} client:load />
  </body>
</html>
