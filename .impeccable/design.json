 "narrative": {
  "northStar": "Pincelada: o mesmo gesto, nunca a mesma imagem",
  "overview": "Van Gogh como sistema: cada texto ganha uma tela de pinceladas gerada do próprio slug no build, nas cores do quadro e da marca. O texto fica sempre em faixa sólida, costurada à pintura pelo fio laranja; a leitura acontece em papel frio.",
  "keyCharacteristics": [
   "Tela gerada por texto (capa, OG, faixa, abertura, capa do Substack)",
   "Azul-escuro como chão, laranja como luz rara",
   "Literata + Hanken Grotesk",
   "Cantos retos, sem sombra, sem glow",
   "Coluna de leitura em papel frio a 40rem"
  ],
  "rules": [
   {
    "name": "Nada atrás do texto",
    "body": "Pintura acima ou ao lado; todo texto em faixa sólida.",
    "section": "elevation"
   },
   {
    "name": "Fio na costura",
    "body": "O fio laranja de 3px só aparece entre pintura e texto; o fio vivo só nos cards.",
    "section": "colors"
   },
   {
    "name": "Rótulo abaixo",
    "body": "Eixo e categoria ficam abaixo do título, com a data.",
    "section": "typography"
   }
  ],
  "dos": [
   "Gerar a capa de texto novo pelo gerador",
   "Manter o laranja em até quatro luzes por tela",
   "Subir VERSAO ao mudar o gerador"
  ],
  "donts": [
   "Sombra, glow, vidro, blur ou gradiente de texto",
   "Borda colorida em cards e caixas",
   "Foto de banco como capa",
   "Mono fora de código"
  ]
 }
